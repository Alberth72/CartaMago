# Supabase project credentials
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Branch identifier - change this to switch between restaurant branches
# Each branch needs its own row in the 'branches' table and a seed entry
VITE_BRANCH_ID=brasas-sazon

# Storage bucket for menu images
VITE_MENU_STORAGE_BUCKET=menu-assets

# Optional NestJS API base URL for migrated command paths
VITE_API_BASE_URL=http://127.0.0.1:3333

# NestJS API foundation
API_HOST=127.0.0.1
API_PORT=3333
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional for API readiness checks and future command handlers
# Use the direct Postgres connection string for Supabase local/cloud.
DATABASE_URL=
DATABASE_SSL=false

# Optional WhatsApp Cloud API confirmation from create-order
# Keep real values in local .env or Supabase secrets, never in source.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=pedido_recibido
WHATSAPP_TEMPLATE_LANGUAGE=es_CO
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_DEFAULT_COUNTRY_CODE=57
WHATSAPP_CONFIRMATION_TO_OVERRIDE=
PUBLIC_SITE_URL=http://localhost:5173

# Optional WABA id for template administration outside create-order
WHATSAPP_BUSINESS_ACCOUNT_ID=
