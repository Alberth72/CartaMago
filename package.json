{
  "name": "cartamago",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "dev:localdb": "node scripts/check-localdb-env.mjs && vite --mode localdb",
    "api:dev": "tsx watch apps/api/src/main.ts",
    "api:build": "tsc -p apps/api/tsconfig.build.json",
    "api:start": "node dist/apps/api/src/main.js",
    "api:check": "tsc -p apps/api/tsconfig.build.json --noEmit",
    "build": "tsc -b && vite build",
    "build:localdb": "node scripts/check-localdb-env.mjs && tsc -b && vite build --mode localdb",
    "lint": "oxlint",
    "preview": "vite preview",
    "preview:local": "vite preview --host 127.0.0.1 --port 4175",
    "test:e2e": "playwright test",
    "test:e2e:admin": "playwright test --config playwright.admin.config.ts",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test": "vitest run",
    "test:stress": "node scripts/run-k6.mjs",
    "test:stress:cloud": "node scripts/run-k6.mjs cloud",
    "supabase:create-admin": "node scripts/create-supabase-admin.mjs",
    "local:setup": "node scripts/setup-local.mjs",
    "local:reset": "node scripts/setup-local.mjs --skip-start",
    "local:down": "npx.cmd supabase stop"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "@supabase/supabase-js": "^2.110.8",
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.25.0",
    "pg": "^8.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-helmet-async": "^3.0.0",
    "react-router": "8.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^24.13.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "qrcode": "^1.5.4",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^3.2.4"
  }
}
