{
  "name": "cartamago",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "dev:localdb": "vite --mode localdb",
    "build": "tsc -b && vite build",
    "build:localdb": "tsc -b && vite build --mode localdb",
    "lint": "oxlint",
    "preview": "vite preview",
    "preview:local": "vite preview --host 127.0.0.1 --port 4175",
    "test:e2e": "playwright test",
    "test:e2e:admin": "playwright test --config playwright.admin.config.ts",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:stress": "node scripts/run-k6.mjs",
    "test:stress:cloud": "node scripts/run-k6.mjs cloud",
    "supabase:create-admin": "node scripts/create-supabase-admin.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-helmet-async": "^3.0.0",
    "react-router": "8.3.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "qrcode": "^1.5.4",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
